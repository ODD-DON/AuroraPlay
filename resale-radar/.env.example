# Resale Radar configuration. Every integration is optional; the app runs locally with none of these.
# Copy to .env.local and fill in only what you have.

# Database. Leave unset to use the embedded local database under .data/ (single owner, no login).
# DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
# RR_AUTO_MIGRATE=1

# Supabase Auth + Storage (production)
# NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Claude (AI identification, screenshot import, AI Advisor)
# ANTHROPIC_API_KEY=
# RR_MODEL_DEEP=claude-opus-5-5
# RR_MODEL_FAST=claude-haiku-5-5

# Google Maps Routes API (traffic-aware drive times and tolls)
# GOOGLE_MAPS_API_KEY=

# eBay Browse API (active listing discovery and active counts)
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=

# Notifications
# RESEND_API_KEY=
# ALERT_EMAIL_TO=
# ALERT_EMAIL_FROM=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# APP_BASE_URL=https://your-deployment.example.com

# Scheduled jobs (Vercel Cron or any scheduler calling /api/cron/tick)
# CRON_SECRET=
